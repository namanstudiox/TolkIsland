<Window x:Class="TolkIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TolkIsland"
        Title="Tolk Island"
        Width="630" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Window.Resources>
        <FontFamily x:Key="UiText">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="UiDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FF9C9CA3"/>
        <SolidColorBrush x:Key="ChipBrush" Color="#FF2C2C2E"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#FF0A84FF"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#FF30D158"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#FF3A3A3C"/>
        <SolidColorBrush x:Key="AccentInkBrush" Color="#FF0B0B0D"/>
        <SolidColorBrush x:Key="GreenInkBrush" Color="#FF0B0B0D"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="TextHoverBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CircleBorderBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="ShellBorderBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FF0A84FF"/>

        <!-- Idle home: controls sit on a barely-there tile; "on" is a tinted
             surface with a coloured glyph, never a solid accent slab. -->
        <SolidColorBrush x:Key="HomeTileBrush" Color="#0CFFFFFF"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#24FF6B6B"/>
        <SolidColorBrush x:Key="AccentFillBrush" Color="#FFFF6B6B"/>
        <SolidColorBrush x:Key="GreenSurfaceBrush" Color="#2430D158"/>
        <SolidColorBrush x:Key="WarmBrush" Color="#FFFFB340"/>
        <SolidColorBrush x:Key="WarmSurfaceBrush" Color="#24FFB340"/>

        <!-- Depth without blur: every card is a soft top-lit surface with a
             hairline edge, so panels feel layered instead of painted flat. -->
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
            <GradientStop Color="#0CFFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#38FFFFFF"/>

        <!-- Scrollable lists end in a soft dissolve instead of a sliced card. -->
        <LinearGradientBrush x:Key="PanelFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0.0"/>
            <GradientStop Color="#FF000000" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- One quiet scrollbar for every panel: a 5px thumb, no arrows. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2.5"
                                                    Background="{DynamicResource SecondaryBrush}"
                                                    Opacity="0.5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="WaveBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#FFFF4D8D" Offset="0.0"/>
            <GradientStop Color="#FFFF7A45" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- The sleeping island is a soft light seam, not a hard bar. -->
        <LinearGradientBrush x:Key="HiddenTabBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
            <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="IslandFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="11" BorderThickness="2"
                                BorderBrush="{DynamicResource PrimaryBrush}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeTileFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="15" BorderThickness="2"
                                BorderBrush="{DynamicResource PrimaryBrush}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomePillFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="25" BorderThickness="2"
                                BorderBrush="{DynamicResource PrimaryBrush}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One header recipe for every expanded panel: quiet title, quiet meta. -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiDisplay}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PanelMeta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <Style x:Key="PanelSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ListCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InteractiveListCard" TargetType="Border" BasedOn="{StaticResource ListCard}">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusRing}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A duration card reads as a choice, not a form control. -->
        <Style x:Key="FocusChoiceButton" TargetType="Button">
            <Setter Property="Height" Value="78"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource HomeTileFocusRing}"/>
            <Setter Property="local:ButtonMotion.Enabled" Value="True"/>
            <Setter Property="local:ButtonMotion.PressScale" Value="0.96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="16"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}"
                                    CornerRadius="16" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBrush}"
                                    CornerRadius="16" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A note's check is a small rounded well, not a stock system checkbox. -->
        <Style x:Key="NoteCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Ring" Margin="-4" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                            <Border x:Name="Box" CornerRadius="6" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource TrackBrush}" Background="Transparent"/>
                            <Border x:Name="Fill" CornerRadius="6"
                                    Background="{DynamicResource GreenBrush}" Opacity="0"/>
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="9" Foreground="{DynamicResource GreenInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                                <Setter TargetName="Tick" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusRing}"/>
            <Setter Property="local:ButtonMotion.Enabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}"
                                    CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBrush}"
                                    CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusRing}"/>
            <Setter Property="local:ButtonMotion.Enabled" Value="True"/>
            <Setter Property="local:ButtonMotion.PressScale" Value="0.94"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="22"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverLayer" CornerRadius="22" Opacity="0" IsHitTestVisible="False"
                                    Background="#1B000000"/>
                            <Border x:Name="PressLayer" CornerRadius="22" Opacity="0" IsHitTestVisible="False"
                                    Background="#30000000"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallCircleButton" TargetType="Button" BasedOn="{StaticResource CircleButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="18"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverLayer" CornerRadius="18" Opacity="0" IsHitTestVisible="False"
                                    Background="#1B000000"/>
                            <Border x:Name="PressLayer" CornerRadius="18" Opacity="0" IsHitTestVisible="False"
                                    Background="#30000000"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusRing}"/>
            <Setter Property="local:ButtonMotion.Enabled" Value="True"/>
            <Setter Property="local:ButtonMotion.PressScale" Value="0.96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="18"/>
                            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}"
                                    CornerRadius="18" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBrush}"
                                    CornerRadius="18" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentChipButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
        </Style>

        <Style x:Key="HomeTileButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource HomeTileBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource HomeTileFocusRing}"/>
            <Setter Property="local:ButtonMotion.PressScale" Value="0.94"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="12"/>
                            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}"
                                    CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBrush}"
                                    CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dock items carry a glyph and a word; the surface only appears on
             hover so the row reads as one quiet line of destinations. -->
        <Style x:Key="HomeDockButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource HomeTileFocusRing}"/>
            <Setter Property="local:ButtonMotion.PressScale" Value="0.94"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="13"/>
                            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}"
                                    CornerRadius="13" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBrush}"
                                    CornerRadius="13" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomePillButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="{DynamicResource GreenSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource HomePillFocusRing}"/>
            <Setter Property="local:ButtonMotion.PressScale" Value="0.96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="22"/>
                            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}"
                                    CornerRadius="22" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBrush}"
                                    CornerRadius="22" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="14,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource IslandFocusRing}"/>
            <Setter Property="local:ButtonMotion.Enabled" Value="True"/>
            <Setter Property="local:ButtonMotion.PressScale" Value="0.97"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}"
                                    CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="PressLayer" Background="{DynamicResource PressedBrush}"
                                    CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Fixed-size host window: only the black shell inside it morphs, so the
         layered window never resizes and transitions stay smooth. -->
    <Grid Background="Transparent">
        <Grid x:Name="Shell"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="300" Height="46"
              Background="Transparent"
              SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Display"
              SizeChanged="Shell_SizeChanged"
              MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave"
              MouseWheel="Shell_MouseWheel"
              AllowDrop="True" DragEnter="Shell_DragEnter" DragOver="Shell_DragOver" Drop="Shell_Drop">

            <!-- One filled path: the notch body plus the two concave ears that
                 flare into the top edge. The hairline keeps the light surface
                 separated from a light desktop without adding seams. -->
            <Path x:Name="ShellShape" Fill="#FF000000"
                  Stroke="{DynamicResource ShellBorderBrush}" StrokeThickness="1"
                  Stretch="None" IsHitTestVisible="False" SnapsToDevicePixels="True"/>

            <!-- Spider skin decoration: a web canopy drawn in shell coordinates
                 and clipped to the silhouette. Collapsed for every other skin. -->
            <Path x:Name="WebOverlay" StrokeThickness="1" Stretch="None"
                  Visibility="Collapsed" IsHitTestVisible="False"
                  SnapsToDevicePixels="True"/>

            <!-- Content stays inside the body; the 20 px ears are outside it.
                 The layout transform keeps the content proportional to the
                 island's size setting instead of clipping at smaller scales. -->
            <Grid x:Name="States" Margin="20,0">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>

                <!-- ================= IDLE HIDDEN: a thin resting seam ================= -->
                <Grid x:Name="IdleHiddenPanel" Visibility="Collapsed" Background="Transparent">
                    <Border x:Name="IdleHiddenTab" Width="44" Height="3" CornerRadius="1.5"
                            Background="{StaticResource HiddenTabBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- ================= IDLE: clock left, battery right ================= -->
                <Grid x:Name="IdlePanel" Margin="26,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock x:Name="ClockText" Text="--:--"
                                   FontFamily="{StaticResource UiDisplay}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="QuietGlyph" Text="&#xE708;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   VerticalAlignment="Center" Margin="8,1,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="BatteryText" Text="&#x2014;"
                                   FontFamily="{StaticResource UiText}" FontSize="12.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Grid x:Name="BatteryGraphic" Width="21" Height="11" VerticalAlignment="Center"
                              ToolTip="Battery">
                            <Border Width="18" Height="10" CornerRadius="3" HorizontalAlignment="Left"
                                    BorderThickness="1" BorderBrush="{DynamicResource SecondaryBrush}" Opacity="0.55"/>
                            <Border x:Name="BatteryFill" Width="0" Height="4" CornerRadius="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="3,0,0,0" Background="{DynamicResource PrimaryBrush}"/>
                            <Border Width="2" Height="4" CornerRadius="1" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Background="{DynamicResource SecondaryBrush}" Opacity="0.55"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ================= IDLE EXPANDED: the island home ================= -->
                <Grid x:Name="IdleExpandedPanel" Margin="24,18" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <!-- The clock is the only hero; one action shares its line. -->
                    <Grid x:Name="IdleHomeHero">
                        <TextBlock x:Name="BigClockText" Text="--:--"
                                   FontFamily="{StaticResource UiDisplay}" FontSize="54" FontWeight="Light"
                                   LineHeight="56" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <StackPanel x:Name="QuickLaunchPanel" Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                            <Button x:Name="FocusEntryButton"
                                    Style="{StaticResource HomePillButton}"
                                    Height="34" MinWidth="96"
                                    Margin="12,0,0,0"
                                    ToolTip="Start a focus session"
                                    AutomationProperties.Name="Start a focus session"
                                    Click="FocusEntry_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource GreenBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Focus" Margin="7,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- One meta line under the clock: date left, power right. -->
                    <Grid x:Name="IdleHomeHeader" Grid.Row="1">
                        <TextBlock x:Name="DateText" Text=""
                                   FontFamily="{StaticResource UiText}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Grid x:Name="HomeBatteryGraphic" Width="21" Height="11" Margin="0,0,7,0"
                                  VerticalAlignment="Center" ToolTip="Battery">
                                <Border Width="18" Height="10" CornerRadius="3" HorizontalAlignment="Left"
                                        BorderThickness="1" BorderBrush="{DynamicResource SecondaryBrush}" Opacity="0.55"/>
                                <Border x:Name="HomeBatteryFill" Width="0" Height="4" CornerRadius="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="3,0,0,0" Background="{DynamicResource PrimaryBrush}"/>
                                <Border Width="2" Height="4" CornerRadius="1" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Background="{DynamicResource SecondaryBrush}" Opacity="0.55"/>
                            </Grid>
                            <TextBlock x:Name="HomeBatteryText" Text="&#x2014;"
                                       FontFamily="{StaticResource UiText}" FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- One hairline separates "now" from "go". -->
                    <Border Grid.Row="3" Background="{DynamicResource HairlineBrush}"/>

                    <!-- Four destinations, each with its own word, so no glyph
                         has to be guessed. Surfaces only appear on hover. -->
                    <UniformGrid x:Name="IdleHomeDock" Grid.Row="5" Columns="4" Rows="1"
                                 Margin="-20,0">
                        <Button x:Name="ShelfEntryButton" Style="{StaticResource HomeDockButton}"
                                ToolTip="Open the file shelf"
                                AutomationProperties.Name="Open the file shelf"
                                Click="ShelfEntry_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Shelf" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NotesEntryButton" Style="{StaticResource HomeDockButton}"
                                ToolTip="Open quick notes"
                                AutomationProperties.Name="Open quick notes"
                                Click="NotesEntry_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Notes" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CalendarEntryButton" Style="{StaticResource HomeDockButton}"
                                ToolTip="Calendar and join-meeting links"
                                AutomationProperties.Name="Open calendar"
                                Click="CalendarEntry_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Calendar" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PromptEntryButton" Style="{StaticResource HomeDockButton}"
                                ToolTip="Quick prompt"
                                AutomationProperties.Name="Open quick prompt"
                                Click="PromptEntry_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Prompt" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MirrorEntryButton" Style="{StaticResource HomeDockButton}"
                                ToolTip="Open the mirror"
                                AutomationProperties.Name="Open the mirror"
                                Click="MirrorEntry_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Mirror" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>

                <!-- ================= COMPACT NOW PLAYING: art left, waveform right ================= -->
                <Grid x:Name="CompactPanel" Margin="16,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="11" ClipToBounds="True"
                            VerticalAlignment="Center" Background="{DynamicResource ArtPlaceholder}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Image x:Name="CompactArt" Stretch="UniformToFill"
                               SizeChanged="Artwork_SizeChanged"/>
                    </Border>

                    <StackPanel x:Name="WaveformHost" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Height="24"/>
                </Grid>

                <!-- ================= COMPACT FOCUS ================= -->
                <Grid x:Name="CompactFocusPanel" Margin="16,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="26" Height="26" VerticalAlignment="Center">
                        <Ellipse Width="26" Height="26" Stroke="{DynamicResource TrackBrush}" StrokeThickness="3"/>
                        <Path x:Name="CompactTimerArc" Stroke="{DynamicResource GreenBrush}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>

                    <TextBlock x:Name="CompactFocusTime" Grid.Column="1" Text="25:00"
                               FontFamily="{StaticResource UiDisplay}" FontSize="15" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="CompactFocusLabel" Grid.Column="2" Text="Focus"
                               FontFamily="{StaticResource UiText}" FontSize="11.5"
                               Foreground="{DynamicResource SecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ================= EXPANDED NOW PLAYING ================= -->
                <Grid x:Name="ExpandedPanel" Margin="22,18" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Art is the one heavy surface here: a hairline edge and one
                         soft shadow lift it above the shell without blurring text. -->
                    <Grid Width="104" Height="104" VerticalAlignment="Center">
                        <Border CornerRadius="22" Background="{DynamicResource ArtPlaceholder}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270"
                                                  Opacity="0.30" Color="#FF000000"
                                                  RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="22" ClipToBounds="True">
                            <Image x:Name="ExpandedArt" Stretch="UniformToFill"
                                   SizeChanged="Artwork_SizeChanged"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="20,3,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ExpandedTitle" Text="No media"
                                   FontFamily="{StaticResource UiDisplay}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ExpandedArtist" Text=""
                                   FontFamily="{StaticResource UiText}" FontSize="13"
                                   Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PositionText" Text="0:00" FontFamily="{StaticResource UiText}"
                                       Foreground="{DynamicResource SecondaryBrush}" FontSize="11.5"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center"/>
                            <local:SeekSurface x:Name="ProgressHit" Grid.Column="1" Height="20" Margin="10,0"
                                  Background="Transparent" Cursor="Hand"
                                  ToolTip="Click, drag or use arrow keys to seek"
                                  AutomationProperties.Name="Seek in the current track"
                                  AutomationProperties.HelpText="Left and Right seek five seconds; hold Control for thirty."
                                  SeekRequested="ProgressHit_SeekRequested"
                                  MouseLeftButtonDown="ProgressHit_MouseLeftButtonDown"
                                  MouseMove="ProgressHit_MouseMove"
                                  MouseLeftButtonUp="ProgressHit_MouseLeftButtonUp"
                                  LostMouseCapture="ProgressHit_LostMouseCapture">
                                <Border x:Name="ProgressTrack" Height="5" VerticalAlignment="Center"
                                        CornerRadius="2.5" Background="{DynamicResource TrackBrush}">
                                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                                            CornerRadius="2.5" Background="{DynamicResource PrimaryBrush}"/>
                                </Border>
                                <Ellipse x:Name="ProgressKnob" Width="9" Height="9"
                                         Fill="{DynamicResource PrimaryBrush}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         IsHitTestVisible="False">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ProgressKnobTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </local:SeekSurface>
                            <TextBlock x:Name="DurationText" Grid.Column="2" Text="--:--" FontFamily="{StaticResource UiText}"
                                       Foreground="{DynamicResource SecondaryBrush}" FontSize="11.5"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ShuffleButton" Content="&#xE8B1;" Style="{StaticResource IconButton}"
                                    Width="30" FontSize="13.5" ToolTip="Shuffle"
                                    AutomationProperties.Name="Shuffle" Click="ShuffleButton_Click"/>
                            <Button x:Name="PrevButton" Grid.Column="1" Content="&#xE892;" Style="{StaticResource IconButton}"
                                    Width="34" FontSize="16"
                                    AutomationProperties.Name="Previous track" Click="PrevButton_Click"/>
                            <Button x:Name="PlayPauseButton" Grid.Column="2" Style="{StaticResource CircleButton}"
                                    Margin="10,0" AutomationProperties.Name="Play or pause"
                                    Click="PlayPauseButton_Click">
                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#FF000000"/>
                            </Button>
                            <Button x:Name="NextButton" Grid.Column="3" Content="&#xE893;"
                                    Style="{StaticResource IconButton}" Width="34" FontSize="16"
                                    AutomationProperties.Name="Next track" Click="NextButton_Click"/>
                            <Button x:Name="RepeatButton" Grid.Column="4" Content="&#xE8EE;" Style="{StaticResource IconButton}"
                                    Width="30" FontSize="13.5" ToolTip="Repeat"
                                    AutomationProperties.Name="Repeat" Click="RepeatButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ================= FOCUS PICKER ================= -->
                <Grid x:Name="FocusPickerPanel" Margin="22,18" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Focus" Style="{StaticResource PanelTitle}"/>
                        <Button Content="Cancel" Style="{StaticResource TextButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="FocusCancel_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Pick a length. The island keeps the time."
                               Style="{StaticResource PanelSubtitle}"/>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.45*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="Focus15Button" Style="{StaticResource FocusChoiceButton}" Margin="0,0,8,0"
                                AutomationProperties.Name="Start a 15 minute focus session" Click="Focus15_Click">
                            <StackPanel>
                                <TextBlock Text="15" FontFamily="{StaticResource UiDisplay}" FontSize="24"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="minutes" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="Focus25Button" Grid.Column="1" Style="{StaticResource FocusChoiceButton}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Start a 25 minute focus session" Click="Focus25_Click">
                            <StackPanel>
                                <TextBlock Text="25" FontFamily="{StaticResource UiDisplay}" FontSize="24"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="minutes" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="Focus50Button" Grid.Column="2" Style="{StaticResource FocusChoiceButton}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Start a 50 minute focus session" Click="Focus50_Click">
                            <StackPanel>
                                <TextBlock Text="50" FontFamily="{StaticResource UiDisplay}" FontSize="24"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="minutes" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="FocusStopwatchButton" Grid.Column="3" Style="{StaticResource FocusChoiceButton}"
                                AutomationProperties.Name="Start a stopwatch" Click="FocusStopwatch_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Stopwatch" FontFamily="{StaticResource UiText}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ================= FOCUS TIMER ================= -->
                <Grid x:Name="TimerPanel" Margin="22,16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="104" Height="104" VerticalAlignment="Center">
                        <Ellipse Width="104" Height="104" Stroke="{DynamicResource TrackBrush}" StrokeThickness="6"/>
                        <Path x:Name="TimerProgressArc" Stroke="{DynamicResource GreenBrush}" StrokeThickness="6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="{DynamicResource SecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TimerRemainingText" Text="25:00"
                                   FontFamily="{StaticResource UiDisplay}" FontSize="44" FontWeight="Light"
                                   LineHeight="46" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="TimerSubtitleText" Text="Focus session"
                                   FontFamily="{StaticResource UiText}" FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="TimerPauseButton" Style="{StaticResource SmallCircleButton}"
                                    Width="34" Height="34"
                                    AutomationProperties.Name="Pause or resume focus timer"
                                    Click="TimerPause_Click">
                                <TextBlock x:Name="TimerPauseGlyph" Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12.5" Foreground="#FF000000"/>
                            </Button>
                            <Button x:Name="TimerResetButton" Content="Reset" Style="{StaticResource TextButton}"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="Reset focus timer" Click="TimerReset_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ================= FOCUS COMPLETE ================= -->
                <Grid x:Name="FocusCompletePanel" Margin="22,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="48" Height="48" VerticalAlignment="Center">
                        <Ellipse Width="48" Height="48" Fill="{DynamicResource GreenSurfaceBrush}"/>
                        <Border Width="38" Height="38" CornerRadius="19"
                                Background="{DynamicResource GreenBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource GreenInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Focus complete"
                                   FontFamily="{StaticResource UiDisplay}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock x:Name="FocusCompleteSubtitle" Text="Session complete"
                                   FontFamily="{StaticResource UiText}" FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ================= NOTIFICATION ================= -->
                <Grid x:Name="NotificationPanel" Margin="22,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AvatarBorder" Width="46" Height="46" CornerRadius="23"
                            Background="{DynamicResource BlueBrush}" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="AvatarText" Text="" Foreground="{DynamicResource AccentInkBrush}"
                                   FontFamily="{StaticResource UiText}" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifHeaderText" Text=""
                                   FontFamily="{StaticResource UiText}" FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifBodyText" Text=""
                                   FontFamily="{StaticResource UiText}" FontSize="16.5"
                                   Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="4,0,0,0">
                        <Button x:Name="NotifReplyButton" Content="Reply" Style="{StaticResource ChipButton}"
                                Height="30" FontSize="12" Padding="0" MinWidth="60"
                                Visibility="Collapsed"
                                ToolTip="Open the toast's own reply box in the Windows notification centre"
                                AutomationProperties.Name="Reply to this notification"
                                Click="NotifReply_Click"/>
                        <Button x:Name="NotifOpenButton" Content="Open" Style="{StaticResource ChipButton}"
                                Height="30" FontSize="12" Padding="0" MinWidth="58"
                                ToolTip="Open Windows notification centre"
                                AutomationProperties.Name="Open notification centre"
                                Click="NotifOpen_Click"/>
                        <Button Content="&#xE711;" Style="{StaticResource IconButton}"
                                Width="30" Height="30" FontSize="13" Margin="4,0,0,0"
                                ToolTip="Dismiss this card"
                                AutomationProperties.Name="Dismiss notification card"
                                Click="NotifDismiss_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ================= CHARGING ================= -->
                <Grid x:Name="ChargingPanel" Margin="26,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="16" CornerRadius="5"
                                BorderBrush="{DynamicResource GreenBrush}" BorderThickness="2">
                            <Grid Margin="2">
                                <Border x:Name="ChargingBatteryFill" Width="0" Height="8" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource GreenBrush}"/>
                            </Grid>
                        </Border>
                        <Border Width="3" Height="8" CornerRadius="1.5" Margin="2,0,0,0"
                                Background="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Charging" FontFamily="{StaticResource UiText}" FontSize="15"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center" Margin="13,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="ChargingPercentText" Grid.Column="2" Text=""
                               FontFamily="{StaticResource UiDisplay}" FontSize="20" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- ================= VOLUME ================= -->
                <Grid x:Name="VolumePanel" Margin="26,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34" CornerRadius="12" VerticalAlignment="Center"
                            Background="{DynamicResource HomeTileBrush}">
                        <TextBlock x:Name="VolumeGlyph" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="VolumeTrack" Grid.Column="1" Width="250" Height="6" CornerRadius="3"
                            Margin="14,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource TrackBrush}">
                        <Border x:Name="VolumeFill" Width="0" HorizontalAlignment="Left" CornerRadius="3"
                                Background="{DynamicResource PrimaryBrush}"/>
                    </Border>

                    <TextBlock x:Name="VolumeText" Grid.Column="2" Text="0" MinWidth="30"
                               FontFamily="{StaticResource UiText}" FontSize="15" FontWeight="Medium"
                               Typography.NumeralAlignment="Tabular" TextAlignment="Right"
                               Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- ================= BRIGHTNESS ================= -->
                <Grid x:Name="BrightnessPanel" Margin="26,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34" CornerRadius="12" VerticalAlignment="Center"
                            Background="{DynamicResource WarmSurfaceBrush}">
                        <TextBlock x:Name="BrightnessGlyph" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource WarmBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="BrightnessTrack" Grid.Column="1" Width="250" Height="6" CornerRadius="3"
                            Margin="14,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource TrackBrush}">
                        <Border x:Name="BrightnessFill" Width="0" HorizontalAlignment="Left" CornerRadius="3"
                                Background="{DynamicResource WarmBrush}"/>
                    </Border>

                    <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="0" MinWidth="30"
                               FontFamily="{StaticResource UiText}" FontSize="15" FontWeight="Medium"
                               Typography.NumeralAlignment="Tabular" TextAlignment="Right"
                               Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- ================= QUICK NOTES ================= -->
                <Grid x:Name="NotesPanel" Margin="22,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Notes" Style="{StaticResource PanelTitle}"/>
                        <TextBlock x:Name="NotesCountText" Text="" Style="{StaticResource PanelMeta}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,8,0,0" Height="34" CornerRadius="11"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NoteInput" Padding="11,0,4,0" Height="32"
                                     Background="Transparent" VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     BorderThickness="0" CaretBrush="{DynamicResource PrimaryBrush}"
                                     FontFamily="{StaticResource UiText}" FontSize="12"
                                     ToolTip="Type a note and press Enter"
                                     AutomationProperties.Name="New note"
                                     KeyDown="NoteInput_KeyDown"/>
                            <Button x:Name="NoteAddButton" Grid.Column="1" Content="Add"
                                    Style="{StaticResource TextButton}" Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Add note"
                                    Click="NoteAdd_Click"/>
                            <TextBlock Text="Write a note…" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       FontFamily="{StaticResource UiText}" FontSize="12"
                                       Foreground="{DynamicResource SecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NoteInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="NotesErrorText" Grid.Row="2" Margin="2,4,0,0"
                               Text="" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" FontSize="11"
                               FontFamily="{StaticResource UiText}"
                               AutomationProperties.LiveSetting="Assertive"
                               Visibility="Collapsed"/>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <ScrollViewer x:Name="NotesScroller" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="ListScroller_ScrollChanged"
                                      Tag="{Binding ElementName=NotesFade}">
                            <StackPanel x:Name="NotesItemsPanel"/>
                        </ScrollViewer>
                        <Border x:Name="NotesFade" Height="22" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Background="{DynamicResource PanelFadeBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="Visible"
                                                     Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=NotesScroller}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <StackPanel x:Name="NotesEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="13"
                                    Background="{DynamicResource HomeTileBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No notes yet" FontFamily="{StaticResource UiText}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Type above and press Enter." FontFamily="{StaticResource UiText}"
                                       FontSize="11" Foreground="{DynamicResource SecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= FILE SHELF ================= -->
                <Grid x:Name="ShelfPanel" Margin="22,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Shelf" Style="{StaticResource PanelTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ShelfCountText" Text="" Style="{StaticResource PanelMeta}"
                                       Margin="0,0,10,0"/>
                            <Button Content="Clear" Style="{StaticResource TextButton}"
                                    ToolTip="Remove every item from the shelf"
                                    AutomationProperties.Name="Clear file shelf"
                                    Click="ShelfClear_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,4">
                        <ScrollViewer x:Name="ShelfScroller" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="ListScroller_ScrollChanged"
                                      Tag="{Binding ElementName=ShelfFade}">
                            <StackPanel x:Name="ShelfItemsPanel"/>
                        </ScrollViewer>
                        <Border x:Name="ShelfFade" Height="22" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Background="{DynamicResource PanelFadeBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="Visible"
                                                     Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=ShelfScroller}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <StackPanel x:Name="ShelfEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="13"
                                    Background="{DynamicResource HomeTileBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Shelf is empty" FontFamily="{StaticResource UiText}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Drop a file on the island to pin it here." FontFamily="{StaticResource UiText}"
                                       FontSize="11" Foreground="{DynamicResource SecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Drag an item out into any app"
                               FontFamily="{StaticResource UiText}" FontSize="11"
                               Foreground="{DynamicResource SecondaryBrush}" Margin="2,0,0,0"/>
                </Grid>

                <!-- ================= CALENDAR / NEXT MEETING ================= -->
                <Grid x:Name="CalendarPanel" Margin="22,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Calendar" Style="{StaticResource PanelTitle}"/>
                        <TextBlock x:Name="CalendarCountText" Text="" Style="{StaticResource PanelMeta}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,4">
                        <StackPanel x:Name="CalendarItemsPanel" VerticalAlignment="Center"/>

                        <StackPanel x:Name="CalendarEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="13"
                                    Background="{DynamicResource HomeTileBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="CalendarEmptyTitle" Text="Nothing scheduled"
                                       FontFamily="{StaticResource UiText}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock x:Name="CalendarEmptyHint" Text="No appointments in the next 18 hours."
                                       FontFamily="{StaticResource UiText}" FontSize="11"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="CalendarHintText" Grid.Row="2" Text="Join opens the meeting link"
                               FontFamily="{StaticResource UiText}" FontSize="11"
                               Foreground="{DynamicResource SecondaryBrush}" Margin="2,0,0,0"/>
                </Grid>

                <!-- ================= QUICK PROMPT ================= -->
                <Grid x:Name="PromptPanel" Margin="22,16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Ask" Style="{StaticResource PanelTitle}"/>
                        <TextBlock x:Name="PromptPrivacyText" Text="Runs on your own machine"
                                   Style="{StaticResource PanelMeta}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="34" CornerRadius="11"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PromptInput" Padding="11,0,4,0" Height="32"
                                         Background="Transparent" VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource PrimaryBrush}"
                                         BorderThickness="0" CaretBrush="{DynamicResource PrimaryBrush}"
                                         FontFamily="{StaticResource UiText}" FontSize="12"
                                         ToolTip="Ask a question. With no AI provider set, Enter copies the prompt"
                                         AutomationProperties.Name="Prompt"
                                         KeyDown="PromptInput_KeyDown"/>
                                <Button x:Name="PromptSendButton" Grid.Column="1" Content="Run"
                                        Style="{StaticResource AccentChipButton}" Height="26" MinWidth="44"
                                        Margin="0,0,4,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Run prompt"
                                        Click="PromptSend_Click"/>
                                <TextBlock Text="Ask anything…" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           FontFamily="{StaticResource UiText}" FontSize="12"
                                           Foreground="{DynamicResource SecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PromptInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Button x:Name="PromptCancelButton" Grid.Column="1" Content="Cancel"
                                Style="{StaticResource TextButton}" Margin="6,0,0,0"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Cancel prompt"
                                Click="PromptCancel_Click"/>
                    </Grid>

                    <ScrollViewer x:Name="PromptScroller" Grid.Row="2" Margin="2,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="ListScroller_ScrollChanged"
                                  Tag="{Binding ElementName=PromptFade}">
                        <TextBlock x:Name="PromptAnswer" Text=""
                                   FontFamily="{StaticResource UiText}" FontSize="12.5" LineHeight="19"
                                   Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <Border x:Name="PromptFade" Grid.Row="2" Height="22" VerticalAlignment="Bottom" Margin="0,10,0,0"
                            IsHitTestVisible="False" Background="{DynamicResource PanelFadeBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Value="Visible"
                                                 Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=PromptScroller}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <!-- ================= MIRROR ================= -->
                <!-- The camera preview is the whole surface; text and controls sit
                     on scrims so they stay legible over any frame. -->
                <Grid x:Name="MirrorPanel" Margin="12" Visibility="Collapsed">
                    <Border CornerRadius="24" Background="#FF08080B" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="MirrorPreview" Stretch="UniformToFill" Visibility="Collapsed"
                                   RenderTransformOrigin="0.5,0.5"
                                   SizeChanged="MirrorPreview_SizeChanged"
                                   AutomationProperties.Name="Mirror camera preview">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="MirrorPreviewScale" ScaleX="-1" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>

                            <Border VerticalAlignment="Top" Height="92" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#B8000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border VerticalAlignment="Bottom" Height="70" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#A6000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid VerticalAlignment="Top" Margin="18,13,12,0" Panel.ZIndex="2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Mirror" FontFamily="{StaticResource UiDisplay}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                    <Border x:Name="MirrorLiveChip" Margin="10,0,0,0" CornerRadius="7"
                                            Padding="7,2,8,3" Background="#40000000"
                                            BorderBrush="#33FFFFFF" BorderThickness="1"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="MirrorLiveDot" Width="5" Height="5"
                                                     Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Live" Margin="5,0,0,0" FontSize="10"
                                                       FontFamily="{StaticResource UiText}" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Button x:Name="MirrorCloseButton" Content="&#xE711;"
                                        Style="{StaticResource IconButton}"
                                        Width="30" Height="30" FontSize="11"
                                        Foreground="#FFFFFFFF" Background="#33000000"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ToolTip="Close mirror"
                                        AutomationProperties.Name="Close mirror"
                                        Click="MirrorClose_Click"/>
                            </Grid>

                            <TextBlock Text="Preview only · the camera stops when this closes"
                                       VerticalAlignment="Bottom" Margin="18,0,16,12"
                                       FontFamily="{StaticResource UiText}" FontSize="11"
                                       Foreground="#B3FFFFFF"/>

                            <Border x:Name="MirrorShutter" Background="#FF08080B" CornerRadius="24">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="54" Height="54" CornerRadius="18"
                                            Background="#14FFFFFF" HorizontalAlignment="Center">
                                        <TextBlock x:Name="MirrorStatusGlyph" Text="&#xE722;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   Foreground="#FFFFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="MirrorStatusTitle" Text="Starting camera…"
                                               FontFamily="{StaticResource UiDisplay}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                               AutomationProperties.LiveSetting="Polite"
                                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock x:Name="MirrorStatusHint" Text="Preview only. Nothing is recorded."
                                               FontFamily="{StaticResource UiText}" FontSize="11"
                                               Foreground="#99FFFFFF"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <StackPanel x:Name="MirrorActions" Orientation="Horizontal"
                                                HorizontalAlignment="Center" Margin="0,14,0,0"
                                                Visibility="Collapsed">
                                        <Button x:Name="MirrorRetryButton" Content="Try again"
                                                Style="{StaticResource AccentChipButton}" Height="28"
                                                AutomationProperties.Name="Try the camera again"
                                                Click="MirrorRetry_Click"/>
                                        <Button x:Name="MirrorSettingsButton" Content="Camera settings"
                                                Style="{StaticResource TextButton}" Margin="8,0,0,0"
                                                Foreground="#FFFFFFFF"
                                                AutomationProperties.Name="Open Windows camera privacy settings"
                                                Click="MirrorOpenSettings_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= LIVE ACTIVITY ================= -->
                <Grid x:Name="LiveActivityPanel" Margin="22,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource GreenSurfaceBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="LiveActivityGlyph" Text="&#xE896;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{DynamicResource GreenBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LiveActivityTitle" Text=""
                                   FontFamily="{StaticResource UiDisplay}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="LiveActivityBody" Grid.Row="1" Text=""
                                   FontFamily="{StaticResource UiText}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>

                        <Border x:Name="LiveActivityTrack" Grid.Row="2" Height="4" CornerRadius="2"
                                Background="{DynamicResource TrackBrush}" Margin="0,8,60,0"
                                Visibility="Collapsed">
                            <Border x:Name="LiveActivityFill" Height="4" CornerRadius="2"
                                    Background="{DynamicResource GreenBrush}"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>

            <!-- Spider skin mascot: a small spider on a single thread, hung
                 from the island's bottom edge. Decorative, never hit-testable;
                 the skin and the ambient states decide when it is shown. -->
            <Grid x:Name="SpiderBuddy"
                  Width="56" Height="58"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Margin="0,0,0,-58"
                  RenderTransformOrigin="0.5,0"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="SpiderSway"/>
                </Grid.RenderTransform>
                <Image x:Name="SpiderBuddyImage" Stretch="Fill"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
