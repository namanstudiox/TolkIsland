<Window x:Class="TolkIsland.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tolk Island"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF18181E" Offset="0.0"/>
            <GradientStop Color="#FF111116" Offset="0.6"/>
            <GradientStop Color="#FF0E0E12" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ShadowSurfaceBrush" Color="#FF0A0A0D"/>
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="TitleInkBrush" Color="#FFF4F4F6"/>
        <SolidColorBrush x:Key="MessageInkBrush" Color="#FFA2A2AB"/>
        <SolidColorBrush x:Key="LogoPlateSurfaceBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="LogoPlateBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="FocusRingBrush" Color="#FFF4F4F6"/>
        <SolidColorBrush x:Key="SecondaryButtonSurfaceBrush" Color="#0EFFFFFF"/>
        <SolidColorBrush x:Key="SecondaryButtonInkBrush" Color="#FFF4F4F6"/>
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryButtonSurfaceBrush" Color="#FFF6F6F8"/>
        <SolidColorBrush x:Key="PrimaryButtonInkBrush" Color="#FF0B0B0D"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#FFE0E0E6"/>
        <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#FFC8C8CF"/>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonInkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="14" BorderThickness="2"
                                    BorderBrush="{DynamicResource FocusRingBrush}" Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11"
                                    BorderBrush="{DynamicResource SecondaryButtonBorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonInkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="14" BorderThickness="2"
                                    BorderBrush="{DynamicResource FocusRingBrush}" Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="20" Background="{DynamicResource ShadowSurfaceBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="#FF000000"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="20" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}"
                Padding="24,22,24,20" MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="11"
                            Background="{DynamicResource LogoPlateSurfaceBrush}"
                            BorderBrush="{DynamicResource LogoPlateBorderBrush}" BorderThickness="1">
                        <Image Source="{StaticResource TolkLogoMark}" Margin="7"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleInkBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                    <TextBlock x:Name="MessageText" FontSize="13" LineHeight="20"
                               Foreground="{DynamicResource MessageInkBrush}" TextWrapping="Wrap"/>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}"
                            IsCancel="True" Click="Secondary_Click"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="Primary_Click" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
